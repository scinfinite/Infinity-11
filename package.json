{
  "name": "@infinity-11/root",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json tsconfig*.json eslint.config.mjs .prettierrc.json vitest.config.ts packages/**/*.json packages/**/*.ts apps/**/*.json apps/**/*.ts tests/**/*.ts .github/workflows/**/*.yml",
    "lint": "eslint packages apps tests",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:regression": "vitest run tests/regression",
    "security": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.6",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.6"
  }
}
